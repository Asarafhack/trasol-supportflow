# Trasol SupportFlow 360 - Frontend Environment Variables
# In local development with Vite dev server, /api and /ws are proxied to http://127.0.0.1:8000 by default.

# Optional custom backend URL override (e.g., http://localhost:8000)
VITE_API_URL=

# Optional custom WebSocket URL override (e.g., ws://localhost:8000)
VITE_WS_URL=
